{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./src/shared/*"],
      "@features/*": ["./src/features/*"],
      "@data/*": ["./src/data/*"]
    }
  },
  "include": ["api/**/*", "server-dev.js", "src/shared/utils/**/*"]
}
