    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.400.0",
    "marked": "^17.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-helmet-async": "^2.0.5",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.30.2",
    "remark-gfm": "^4.0.1",
    "tslib": "^2.8.1"
